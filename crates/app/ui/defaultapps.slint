// Desktop › Default apps, following the "Default apps and updates" mockups (approved 2026-11-23,
// D-39): one app per kind in two cards on the left (Everyday; Media and documents), file types
// that differ from their kind's app on the right, with a search for any file type. An app is
// chosen in a list of the apps that say they open it, or any app. "Where these come from" lists
// the files apps read. What it shows comes from Rust (src/defaultapps.rs); everything done goes
// back through `act`.
import { Theme, Type, Size } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, Focusable, SectionLabel, CardTitle, Scroll, Badge, Link, IconTile, Notice } from "controls.slint";
import { TextField, Modal, SelectButton , DialogTitle, DialogButtons} from "dialogs.slint";
import { Hero, HeroSubject, Card, ScrollCard, EmptyState, DividerRow } from "shell.slint";

/// An app: its desktop file id, name, a line about it ("Flatpak · app.zen_browser.zen"), and
/// its icon (or its first letter on a tile when it has none).
export struct AppChoice { id: string, name: string, detail: string, icon: image, letter: string, selected: bool }
/// A kind: its app, and a line under its name (hint); mixed: some of its types open elsewhere
/// ("11 of 12 file types · GIF opens in Firefox"), with `fix` ("Use imv for all"); note: where its
/// app comes from when that's worth saying ("EndeavourOS's default").
export struct KindRow { key: string, label: string, hint: string, icon: string, app: AppChoice, mixed: string, fix: string, note: string }
/// A file type: "PNG image", "image/png · .png", its app.
export struct TypeRow { mime: string, name: string, line: string, app: AppChoice }
/// A file apps read, first one first; saves: Lituus writes there.
export struct DaSource { path: string, what: string, saves: bool, mono: bool }
export struct DefaultAppsView {
    state: string,
    hero-title: string,
    hero-apps: [AppChoice],
    hero-more: string,
    banner: string,
    everyday: [KindRow],
    media: [KindRow],
    types-title: string,
    types-right: string,
    types: [TypeRow],
    types-note: string,
    picker-open: bool,
    picker-title: string,
    picker-hint: string,
    picker-all: bool,
    picker-apps: [AppChoice],
    sources-open: bool,
    sources: [DaSource],
    error: string,
}

/// An app's icon, or its first letter on a tile.
export component AppTile inherits Rectangle {
    in property <AppChoice> app;
    in property <length> size: 22px;
    width: size;
    height: size;
    border-radius: size / 4;
    background: root.app.icon.width > 0 ? transparent : Theme.accent-soft-bg;
    if root.app.icon.width > 0: Image { width: root.size; height: root.size; source: root.app.icon; image-fit: contain; }
    if root.app.icon.width == 0: Text { text: root.app.letter; color: Theme.accent; font-size: root.size * 0.5; font-weight: 700; }
}

/// The app chosen for something, as a button that opens the list to choose another.
/// The app chosen for something: the shared SelectButton with the app's icon (D-46).
export component AppSelect inherits SelectButton {
    in property <AppChoice> app;
    text: root.app.name == "" ? "None" : root.app.name;
    AppTile { app: root.app; y: (parent.height - self.height) / 2; }
}

component KindLine inherits DividerRow {
    in property <KindRow> kind;
    in property <bool> narrow;
    callback act(string, string);
    min-height: 62px;
    HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 14px;
        IconTile { icon: root.kind.icon; size: 36px; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.kind.label; color: Theme.text; font-size: Type.body; overflow: elide; }
            if root.kind.mixed == "": Text { text: root.kind.hint + (root.kind.note == "" ? "" : " · " + root.kind.note); color: Theme.muted; font-size: Type.note; wrap: word-wrap; }
            if root.kind.mixed != "": HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle { width: 6px; height: 6px; y: (parent.height - 6px) / 2; border-radius: 3px; background: Theme.warn-text; }
                Text { text: root.kind.mixed; color: Theme.warn-text; font-size: Type.note; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    Link { text: root.kind.fix; font-size: Type.note; focus-key: "fix:" + root.kind.key; clicked => { root.act("fix", root.kind.key); } }
                }
            }
        }
        AppSelect {
            width: root.narrow ? 220px : 300px;
            y: (parent.height - self.height) / 2;
            app: root.kind.app;
            label: root.kind.label;
            focus-key: "kind:" + root.kind.key;
            clicked => { root.act("choose-kind", root.kind.key); }
        }
    }
}

component TypeLine inherits DividerRow {
    in property <TypeRow> entry;
    callback act(string, string);
    min-height: 52px;
    HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.entry.name; color: Theme.text; font-size: Type.body; overflow: elide; }
            Text { text: root.entry.line; color: Theme.faint; font-size: Type.note; font-family: "JetBrains Mono"; overflow: elide; }
        }
        AppSelect {
            width: 220px;
            y: (parent.height - self.height) / 2;
            app: root.entry.app;
            label: root.entry.name;
            focus-key: "type:" + root.entry.mime;
            clicked => { root.act("choose-type", root.entry.mime); }
        }
    }
}

export component DefaultAppsPage inherits VerticalLayout {
    in property <DefaultAppsView> view;
    in property <bool> compact;
    in property <bool> narrow;
    in-out property <string> query;
    callback act(string, string);
    spacing: 14px;

    Hero {
        title: "Default apps";
        sub: "Which app opens links, files and a terminal";
        hero-height: root.compact ? 136px : 206px;
        compact: root.compact;
        aside: sources-button.width + 18px;
        HeroSubject {
            compact: root.compact;
            loading: root.view.state != "list";
            info: { icon: "app", name: root.view.hero-title };
            if !root.compact: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for a in root.view.hero-apps: AppTile { app: a; size: 20px; }
                Text { text: root.view.hero-more; color: Theme.muted; font-size: Type.body; vertical-alignment: center; }
            }
        }
        sources-button := Button {
            x: parent.width - self.width - 18px;
            y: 18px;
            width: root.view.state == "list" ? self.preferred-width : 0;
            visible: root.view.state == "list";
            label: "Where these come from";
            focus-key: "sources";
            clicked => { root.act("sources-open", ""); }
        }
    }
    if root.view.banner != "": Notice { text: root.view.banner; dismissible: false; }
    if root.view.error != "": Text { text: root.view.error; color: Theme.danger; font-size: Type.body; wrap: word-wrap; }
    if root.view.state == "list": HorizontalLayout {
        spacing: 14px;
        vertical-stretch: 1;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 18px;
                    padding-top: 14px;
                    spacing: 0;
                    CardTitle { text: "Everyday"; }
                    for k[i] in root.view.everyday: KindLine { kind: k; first: i == 0; narrow: root.narrow; act(v, a) => { root.act(v, a); } }
                }
            }
            ScrollCard {
                VerticalLayout {
                    padding: 18px;
                    padding-top: 14px;
                    spacing: 0;
                    CardTitle { text: "Media and documents"; }
                    for k[i] in root.view.media: KindLine { kind: k; first: i == 0; narrow: root.narrow; act(v, a) => { root.act(v, a); } }
                }
            }
        }
        ScrollCard {
            width: root.narrow ? 400px : 560px;
            VerticalLayout {
                padding: 18px;
                padding-top: 14px;
                spacing: 0;
                CardTitle { text: "By file type"; }
                TextField {
                    icon: "search";
                    height: Size.field;
                    label: "Search a file type";
                    placeholder: "Search a file type: png, .md, video/mp4…";
                    text <=> root.query;
                    edited => { root.act("search", self.text); }
                }
                HorizontalLayout {
                    height: 44px;
                    padding-top: 10px;
                    SectionLabel { text: root.view.types-title; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: root.view.types-right; color: Theme.faint; font-size: Type.note; vertical-alignment: center; }
                }
                for t[i] in root.view.types: TypeLine { entry: t; first: i == 0; act(v, a) => { root.act(v, a); } }
                Text { text: root.view.types-note; color: Theme.faint; font-size: Type.note; wrap: word-wrap; min-height: 34px; vertical-alignment: bottom; }
            }
        }
    }
    if root.view.state != "list": HorizontalLayout {
        spacing: 14px;
        vertical-stretch: 1;
        Card { horizontal-stretch: 1; EmptyState { loading: true; title: "Reading your apps and their file types…"; } }
        Card { width: root.narrow ? 400px : 560px; EmptyState { loading: true; title: " "; } }
    }
}

component PickerRow inherits Focusable {
    in property <AppChoice> app;
    callback chosen();
    height: 44px;
    border-radius: 9px;
    // Each render builds the picker's rows again: the new one takes the focus back.
    focus-key: "picker:" + root.app.id;
    background: self.has-hover || self.has-focus ? Theme.accent-soft-bg : transparent;
    accessible-role: list-item;
    accessible-label: root.app.name;
    accessible-item-selected: root.app.selected;
    accessible-action-default => { chosen(); }
    activated => { root.chosen(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        AppTile { app: root.app; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text { text: root.app.name; color: Theme.text; font-size: Type.body; font-weight: 500; overflow: elide; }
            Text { text: root.app.detail; color: Theme.faint; font-size: Type.label; overflow: elide; }
        }
        if root.app.selected: Icon { name: "check"; tint: Theme.accent; size: 14px; y: (parent.height - 14px) / 2; }
    }
}

/// The apps to choose from for a kind or a file type.
export component AppPickerDialog inherits Modal {
    in property <DefaultAppsView> view;
    callback act(string, string);
    card-width: 460px;
    label: root.view.picker-title;
    dismissed => { root.act("picker-close", ""); }
    DialogTitle { text: root.view.picker-title; }
    Text { text: root.view.picker-hint; color: Theme.muted; font-size: Type.body; wrap: word-wrap; }
    Scroll {
        height: min(root.view.picker-apps.length * 46px + 8px, 440px);
        VerticalLayout {
            spacing: 2px;
            for a in root.view.picker-apps: PickerRow { app: a; chosen => { root.act("pick", a.id); } }
            if root.view.picker-apps.length == 0: Text { text: "No app says it opens these."; color: Theme.faint; font-size: Type.body; height: 40px; vertical-alignment: center; }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        if !root.view.picker-all: Button { label: "Another app…"; horizontal-stretch: 0; button-height: Size.button-dialog; clicked => { root.act("picker-all", ""); } }
        Rectangle { horizontal-stretch: 1; }
        Button { label: "Cancel"; button-height: Size.button-dialog; horizontal-stretch: 0; clicked => { root.act("picker-close", ""); } }
    }
}

/// Where the defaults come from: the files apps read, first one first.
export component SourcesDialog inherits Modal {
    in property <DefaultAppsView> view;
    callback act(string, string);
    card-width: 600px;
    label: "Where default apps come from";
    dismissed => { root.act("sources-close", ""); }
    DialogTitle { text: "Where default apps come from"; }
    Text {
        text: "Apps look in these files, first one first: the first that names an app for a file type wins. Lituus reads them the same way, so the page shows what really opens.";
        color: Theme.muted;
        font-size: Type.body;
        wrap: word-wrap;
    }
    VerticalLayout {
        spacing: 0;
        for s[i] in root.view.sources: Rectangle {
            min-height: 44px;
            if i > 0: Rectangle { y: 0; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: s.path; color: Theme.text; font-size: s.mono ? 12px : 13px; font-family: s.mono ? "JetBrains Mono" : "Inter"; overflow: elide; }
                    Text { text: s.what; color: Theme.muted; font-size: Type.note; wrap: word-wrap; }
                }
                if s.saves: VerticalLayout {
                    alignment: center;
                    Badge { text: "Lituus saves here"; }
                }
            }
        }
    }
    DialogButtons {
        Button { label: "Close"; button-height: Size.button-dialog; clicked => { root.act("sources-close", ""); } }
    }
}
