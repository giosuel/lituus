// The Sound page, following the "Lituus: Sound" mockups and S-157: the output in use is the hero,
// with a big volume slider. Its first view has the Output and Input cards on the left and the apps
// playing and recording on the right (stacked in a narrow window); the sound cards' profiles are
// the second view. The output and the input in use are each chosen from a list, with that
// device's settings under it. What it shows comes from Rust
// (src/sound.rs); everything the user does goes back through `act(verb, id, value)`.
import { Theme, Type, Size } from "theme.slint";
import { Icon, Spinner } from "icons.slint";
import { Button, IconButton, Switch, CardTitle, CardFooter, SectionLabel, Notice, Scroll, Focusable, Focus, AppIcon } from "controls.slint";
import { ViewSwitcher, Select } from "dialogs.slint";
import { Hero, HeroSubject, HeroInfo, Card, ScrollCard, DividerRow, SettingRow, EmptyState } from "shell.slint";

/// An app playing or recording. output: its output's place in `outputs-names`, or for a
/// recording its input's place in `record-from` (-1: neither). icon: its own, when has-icon.
export struct SoundApp { id: string, name: string, sub: string, volume: float, muted: bool, output: int, icon: image, has-icon: bool }
/// A sound card and its profiles.
export struct SoundCard { id: string, name: string, profiles: [string], selected: int }
/// state: "list", "loading" or "not-running" (the empty-* fields say why).
export struct SoundView {
    state: string,
    sub: string,
    hero: HeroInfo,
    /// The output in use: volume (1.0 is 100 %), mute, ports and balance.
    out-volume: float,
    out-muted: bool,
    out-ports: [string],
    out-port: int,
    out-balance: float,
    has-balance: bool,
    /// The outputs: names, a line about each ("Bluetooth · Headphones"), and the one in use
    /// (-1: none). The apps choose from the same names.
    outputs-names: [string],
    outputs-details: [string],
    output: int,
    inputs-names: [string],
    inputs-details: [string],
    input: int,
    in-volume: float,
    in-muted: bool,
    /// The apps playing, and "2 playing · 1 paused".
    apps: [SoundApp],
    apps-line: string,
    /// The apps recording, and their line.
    recordings: [SoundApp],
    recordings-line: string,
    /// What an app can record from: the inputs, then the outputs' monitors.
    record-from: [string],
    record-from-details: [string],
    cards: [SoundCard],
    /// The highest volume the sliders go to: 1.0, or 1.5 with "Louder than 100 %" on.
    max: float,
    overamplify: bool,
    /// The last change the server turned down.
    error: string,
    empty-title: string,
    empty-text: string,
    /// A command that fixes it, with a Copy button.
    empty-command: string,
}

/// A volume slider: drags and arrow keys move it; while it's dragged it shows its own value
/// rather than the server's, which lags behind.
export component Slider inherits Focusable {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> big;
    in property <string> label;
    /// A mark across the track, such as 100 % when it goes higher, or the centre of a balance.
    in property <float> mark: -1;
    /// What the arrow keys move it by.
    in property <float> step: 0.05;
    /// Its value for a screen reader, if not a percentage ("300 ms").
    in property <string> value-text;
    /// Greyed, for a volume that's muted; it still moves.
    in property <bool> faded;
    callback moved(float);
    property <float> local: value;
    property <bool> dragging: touch.pressed;
    property <float> shown: dragging ? local : value;
    property <length> knob: big ? 22px : 16px;
    property <float> fraction: (clamp(shown, minimum, maximum) - minimum) / (maximum - minimum);
    height: big ? 28px : 20px;
    min-width: 80px;
    opacity: root.enabled ? 1 : 0.5;
    // Round, for the focus ring.
    border-radius: self.height / 2;
    clickable: false;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: root.value-text != "" ? root.value-text : round(shown * 100) + " %";
    accessible-value-minimum: minimum * 100;
    accessible-value-maximum: maximum * 100;
    accessible-action-increment => { root.moved(min(root.maximum, root.value + root.step)); }
    accessible-action-decrement => { root.moved(max(root.minimum, root.value - root.step)); }
    key(event) => {
        // Alt+↑↓ and the like are the page's (moving a keyboard layout).
        if event.modifiers.alt || event.modifiers.control { return reject; }
        if event.text == Key.RightArrow || event.text == Key.UpArrow { root.moved(min(root.maximum, root.value + root.step)); return accept; }
        if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.moved(max(root.minimum, root.value - root.step)); return accept; }
        reject
    }
    track := Rectangle {
        x: root.knob / 2;
        width: parent.width - root.knob;
        height: root.big ? 8px : 4px;
        border-radius: self.height / 2;
        // A control's edge colour, so the track stands out 3:1 from the card.
        background: Theme.ctrl-border;
        if root.minimum >= 0: Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            border-radius: parent.border-radius;
            background: root.faded ? Theme.faint : Theme.accent;
        }
        if root.mark >= 0: Rectangle {
            x: parent.width * (root.mark - root.minimum) / (root.maximum - root.minimum) - 1px;
            width: 2px;
            height: parent.height + 8px;
            y: -4px;
            background: Theme.faint;
        }
    }
    Rectangle {
        x: track.x + track.width * root.fraction - root.knob / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.faded ? Theme.faint : Theme.accent;
        border-width: 3px;
        border-color: Theme.surface;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            // A press moves the knob there at once; a drag carries on from it (moved below).
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                // Then the arrow keys move it too; the ring is only for the keyboard.
                Focus.keyboard = false;
                root.focus();
                root.local = root.minimum + clamp((self.mouse-x - track.x) / track.width, 0, 1) * (root.maximum - root.minimum);
                root.moved(root.local);
            }
        }
        moved => {
            if self.pressed {
                root.local = root.minimum + clamp((self.mouse-x - track.x) / track.width, 0, 1) * (root.maximum - root.minimum);
                root.moved(root.local);
            }
        }
    }
}

component Percent inherits Text {
    in property <float> value;
    in property <bool> muted;
    text: muted ? "Muted" : round(value * 100) + " %";
    color: Theme.muted;
    font-size: Type.note;
    font-family: "JetBrains Mono";
    horizontal-alignment: right;
    vertical-alignment: center;
    width: 52px;
}

/// The output in use: which one, its port, balance, and how loud the sliders go.
component OutputCard inherits ScrollCard {
    in property <SoundView> page;
    callback act(string, string, float);
    // Setting rows stay at a width where the label is near its control.
    HorizontalLayout {
        alignment: start;
        VerticalLayout {
            padding: 18px;
            padding-top: 14px;
            spacing: 0;
            alignment: start;
            preferred-width: 756px;
            max-width: 756px;
            horizontal-stretch: 1;
            CardTitle { text: "Output"; }
            if root.page.outputs-names.length == 0: Text { text: "No speakers, headphones or other output."; color: Theme.faint; font-size: Type.note; height: 40px; vertical-alignment: center; }
            if root.page.outputs-names.length > 0: SettingRow {
                label: "Output device";
                description: "Where sound plays";
                first: true;
                Select {
                    min-width: 140px;
                    preferred-width: 240px;
                    horizontal-stretch: 0;
                    select-height: Size.field;
                    label: "Output device";
                    options: root.page.outputs-names;
                    details: root.page.outputs-details;
                    selected: root.page.output;
                    chosen(i) => { root.act("default-sink", "", i); }
                }
            }
            if root.page.out-ports.length > 1: SettingRow {
                label: "Port";
                description: "Which of its connectors plays";
                Select {
                    min-width: 140px;
                    preferred-width: 240px;
                    horizontal-stretch: 0;
                    select-height: Size.field;
                    label: "Port";
                    options: root.page.out-ports;
                    selected: root.page.out-port;
                    chosen(i) => { root.act("out-port", "" + i, 0); }
                }
            }
            if root.page.has-balance: SettingRow {
                label: "Balance";
                HorizontalLayout {
                    spacing: 14px;
                    horizontal-stretch: 0;
                    Text { text: "L"; color: Theme.faint; font-size: Type.note; vertical-alignment: center; }
                    Slider {
                        preferred-width: 180px;
                        label: "Balance";
                        minimum: -1;
                        maximum: 1;
                        mark: 0;
                        value: root.page.out-balance;
                        y: (parent.height - self.height) / 2;
                        moved(v) => { root.act("balance", "", abs(v) < 0.06 ? 0 : v); }
                    }
                    Text { text: "R"; color: Theme.faint; font-size: Type.note; vertical-alignment: center; }
                }
            }
            // It changes every volume slider (the input's and the apps' too), so it
            // sits with the devices rather than under Cards.
            SettingRow {
                label: "Louder than 100 %";
                description: "Lets the volume sliders go to 150 %; sound may distort";
                first: root.page.outputs-names.length == 0;
                Switch { on: root.page.overamplify; label: "Louder than 100 %"; toggled => { root.act("overamplify", "", 0); } }
            }
        }
    }
}

/// The input in use: which one, and its volume.
component InputCard inherits ScrollCard {
    in property <SoundView> page;
    callback act(string, string, float);
    HorizontalLayout {
        alignment: start;
        VerticalLayout {
            padding: 18px;
            padding-top: 14px;
            spacing: 0;
            alignment: start;
            preferred-width: 756px;
            max-width: 756px;
            horizontal-stretch: 1;
            CardTitle { text: "Input"; }
            if root.page.inputs-names.length == 0: Text { text: "No microphone or other input."; color: Theme.faint; font-size: Type.note; height: 40px; vertical-alignment: center; }
            if root.page.inputs-names.length > 0: SettingRow {
                label: "Input device";
                description: "What apps hear";
                first: true;
                Select {
                    min-width: 140px;
                    preferred-width: 240px;
                    horizontal-stretch: 0;
                    select-height: Size.field;
                    label: "Input device";
                    options: root.page.inputs-names;
                    details: root.page.inputs-details;
                    selected: root.page.input;
                    chosen(i) => { root.act("default-source", "", i); }
                }
            }
            // Muted the way the output and the apps are: the button beside its slider.
            if root.page.inputs-names.length > 0: SettingRow {
                label: "Volume";
                description: root.page.in-muted ? "Muted in every app" : "";
                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 0;
                    IconButton {
                        icon: root.page.in-muted ? "mic-off" : "mic";
                        label: root.page.in-muted ? "Unmute the input" : "Mute the input";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.act("in-mute", "", 0); }
                    }
                    Slider {
                        preferred-width: 180px;
                        label: "Input volume";
                        value: root.page.in-volume;
                        maximum: root.page.max;
                        mark: root.page.max > 1 ? 1 : -1;
                        y: (parent.height - self.height) / 2;
                        moved(v) => { root.act("in-volume", "", v); }
                    }
                    Percent { value: root.page.in-volume; muted: root.page.in-muted; }
                }
            }
        }
    }
}

/// A group's label in the Apps card, with how many there are on the right.
component GroupLine inherits HorizontalLayout {
    in property <string> text;
    in property <string> line;
    height: 28px;
    SectionLabel { text: root.text; vertical-alignment: center; horizontal-stretch: 1; }
    Text { text: root.line; color: Theme.faint; font-size: Type.note; vertical-alignment: center; }
}

/// An app playing or recording: its icon (crossed out when muted), its name and what it plays,
/// mute, volume, and the output it plays on or the input it records from.
component StreamRow inherits DividerRow {
    in property <SoundApp> app;
    in property <bool> recording;
    in property <float> max;
    in property <[string]> devices;
    in property <[string]> details;
    callback act(string, string, float);
    property <string> verb: root.recording ? "rec-" : "app-";
    min-height: 56px;
    HorizontalLayout {
        spacing: 12px;
        AppIcon { picture: root.app.icon; has-picture: root.app.has-icon; crossed: root.app.muted; size: 24px; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            // The name gives way to the slider's least width in a narrow card.
            min-width: 100px;
            preferred-width: 200px;
            horizontal-stretch: 0;
            Text { text: root.app.name; color: Theme.text; font-size: Type.body; overflow: elide; }
            if root.app.sub != "": Text { text: root.app.sub; color: Theme.faint; font-size: Type.note; overflow: elide; }
        }
        IconButton {
            icon: root.recording ? (root.app.muted ? "mic-off" : "mic") : (root.app.muted ? "volume-off" : "volume");
            label: (root.app.muted ? "Unmute " : "Mute ") + root.app.name + (root.recording ? " recording" : "");
            focus-key: root.verb + "mute:" + root.app.id;
            y: (parent.height - self.height) / 2;
            clicked => { root.act(root.verb + "mute", root.app.id, 0); }
        }
        Slider {
            horizontal-stretch: 1;
            label: root.app.name + (root.recording ? " recording volume" : " volume");
            focus-key: root.verb + "volume:" + root.app.id;
            value: root.app.volume;
            maximum: root.max;
            mark: root.max > 1 ? 1 : -1;
            y: (parent.height - self.height) / 2;
            moved(v) => { root.act(root.verb + "volume", root.app.id, v); }
        }
        Percent { value: root.app.volume; muted: root.app.muted; }
        Select {
            width: 190px;
            select-height: Size.field;
            label: (root.recording ? "Input for " : "Output for ") + root.app.name;
            focus-key: (root.recording ? "rec-input:" : "app-output:") + root.app.id;
            options: root.devices;
            details: root.details;
            selected: root.app.output;
            y: (parent.height - self.height) / 2;
            chosen(i) => { root.act(root.recording ? "rec-input" : "app-output", root.app.id, i); }
        }
    }
}

/// The apps playing, and those recording while any do; each row is one stream.
component AppsCard inherits ScrollCard {
    in property <SoundView> page;
    callback act(string, string, float);
    // The note stays at the bottom of a tall card.
    fill: true;
    VerticalLayout {
        padding: 18px;
        padding-top: 14px;
        spacing: 0;
        CardTitle { text: "Apps"; }
        GroupLine { text: "PLAYING"; line: root.page.apps-line; }
        if root.page.apps.length == 0: Text { text: "No app is playing sound."; color: Theme.faint; font-size: Type.body; height: 48px; vertical-alignment: center; }
        for a[i] in root.page.apps: StreamRow {
            app: a;
            first: i == 0;
            max: root.page.max;
            devices: root.page.outputs-names;
            details: root.page.outputs-details;
            act(v, id, x) => { root.act(v, id, x); }
        }
        if root.page.recordings.length > 0: VerticalLayout {
            padding-top: 14px;
            GroupLine { text: "RECORDING"; line: root.page.recordings-line; }
        }
        for a[i] in root.page.recordings: StreamRow {
            app: a;
            first: i == 0;
            recording: true;
            max: root.page.max;
            devices: root.page.record-from;
            details: root.page.record-from-details;
            act(v, id, x) => { root.act(v, id, x); }
        }
        Rectangle { vertical-stretch: 1; min-height: 14px; }
        CardFooter { text: "Each row is one stream: an app on a call plays and records, so it has a row in each. Moving one moves only that app; the output and input in use stay as they are."; }
    }
}

export component SoundPage inherits VerticalLayout {
    in property <SoundView> page;
    in-out property <int> tab;
    /// A short window: a smaller hero.
    in property <bool> compact;
    callback act(string, string, float);
    spacing: 14px;
    Hero {
        title: "Sound";
        sub: root.page.sub;
        // With nothing to show, the hero is only the title and its line.
        hero-height: root.compact || root.page.state == "not-running" ? 136px : 206px;
        compact: root.compact;
        aside: sound-tools.width + 18px;
        if root.page.state == "list": HeroSubject {
            compact: root.compact;
            // The name, the volume's line and the slider: a little taller than other subjects.
            subject-height: root.compact ? 64px : 96px;
            info: { icon: root.page.hero.icon, name: root.page.hero.name, meta: root.compact ? "" : root.page.hero.meta };
            // The slider stops at 640 px; a longer one gives no finer control.
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                IconButton {
                    icon: root.page.out-muted ? "volume-off" : "volume";
                    label: root.page.out-muted ? "Unmute" : "Mute";
                    clicked => { root.act("out-mute", "", 0); }
                }
                Slider {
                    big: true;
                    label: "Output volume";
                    value: root.page.out-volume;
                    maximum: root.page.max;
                    mark: root.page.max > 1 ? 1 : -1;
                    y: (parent.height - self.height) / 2;
                    preferred-width: 640px;
                    horizontal-stretch: 1;
                    moved(v) => { root.act("out-volume", "", v); }
                }
                Percent { value: root.page.out-volume; muted: root.page.out-muted; font-size: Type.body; color: Theme.text; }
            }
        }
        // The page's views, top right as on every page.
        sound-tools := HorizontalLayout {
            x: parent.width - self.width - 18px;
            y: 18px;
            width: self.preferred-width;
            height: 34px;
            // Cards only when there's a card with profiles to choose; otherwise there's one view.
            if root.page.state == "list" && root.page.cards.length > 0: ViewSwitcher {
                label: "Sound";
                options: ["Devices and apps", "Cards"];
                selected <=> root.tab;
            }
        }
    }

    // Below the hero the cards reach the bottom and scroll inside; the page scrolls only when
    // the window is too short for them.
    body := Scroll {
        // Two columns when the apps' rows fit beside Output and Input, as in the mockup; in one
        // column the cards keep their height and the page scrolls.
        property <bool> two-columns: self.width >= 1240px;
        // The columns follow its width, so its least width can't follow them.
        min-width: 0;
        vertical-stretch: 1;
        fill: true;
        spacing: 14px;
        bar-inset: -16px;
        // What the server turned down, above what it's about.
        if root.page.state == "list" && root.page.error != "": Notice {
            vertical-stretch: 0;
            tone: "danger";
            text: root.page.error;
            dismissed => { root.act("dismiss", "", 0); }
        }

        if root.page.state == "list" && (root.tab == 0 || root.page.cards.length == 0) && body.two-columns: HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;
            // The same preferred width, so they share the row evenly.
            VerticalLayout {
                preferred-width: 420px;
                horizontal-stretch: 1;
                spacing: 14px;
                OutputCard { whole: true; vertical-stretch: 0; page: root.page; act(v, id, x) => { root.act(v, id, x); } }
                InputCard { page: root.page; act(v, id, x) => { root.act(v, id, x); } }
            }
            AppsCard { preferred-width: 420px; horizontal-stretch: 1; page: root.page; act(v, id, x) => { root.act(v, id, x); } }
        }
        if root.page.state == "list" && (root.tab == 0 || root.page.cards.length == 0) && !body.two-columns: OutputCard {
            whole: true;
            vertical-stretch: 0;
            page: root.page;
            act(v, id, x) => { root.act(v, id, x); }
        }
        if root.page.state == "list" && (root.tab == 0 || root.page.cards.length == 0) && !body.two-columns: InputCard {
            whole: true;
            vertical-stretch: 0;
            page: root.page;
            act(v, id, x) => { root.act(v, id, x); }
        }
        if root.page.state == "list" && (root.tab == 0 || root.page.cards.length == 0) && !body.two-columns: AppsCard {
            whole: true;
            page: root.page;
            act(v, id, x) => { root.act(v, id, x); }
        }

        if root.page.state == "list" && root.tab == 1 && root.page.cards.length > 0: ScrollCard {
            HorizontalLayout {
                alignment: start;
                cards := VerticalLayout {
                    padding: 18px;
                    padding-top: 14px;
                    spacing: 0;
                    alignment: start;
                    preferred-width: 756px;
                    max-width: 756px;
                    horizontal-stretch: 1;
                    CardTitle { text: "Sound cards"; }
                    for c[i] in root.page.cards: SettingRow {
                        label: c.name;
                        description: "Profile: which outputs and inputs it offers";
                        first: i == 0;
                        Select {
                            min-width: 160px;
                            preferred-width: 300px;
                            horizontal-stretch: 0;
                            select-height: Size.field;
                            label: "Profile for " + c.name;
                            focus-key: "profile:" + c.id;
                            options: c.profiles;
                            selected: c.selected;
                            chosen(p) => { root.act("profile", c.id, p); }
                        }
                    }
                }
            }
        }

        if root.page.state != "list": Card {
            vertical-stretch: 1;
            EmptyState {
                icon: "volume-off";
                loading: root.page.state == "loading";
                title: root.page.empty-title;
                text: root.page.empty-text;
                command: root.page.empty-command;
            }
        }
    }
}
