// System › System, following the "System v2" mockups (2026-11-09/10): the computer's names and
// what it is in the hero, with an edit button after the name and a bug button top right that
// copies the page for a bug report; its hardware and drives on the left; Software the full
// height on the right: the distribution, updates per package manager with Update buttons that run
// in the default terminal, what runs, and what Lituus's pages use. What it shows comes from Rust
// (src/system.rs).
import { Theme, Type, Size } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, IconButton, CardTitle, SectionLabel, IconTile } from "controls.slint";
import { Hero, HeroSubject, Card, ScrollCard, Tooltip, EmptyState } from "shell.slint";

/// A fact about the hardware: what it is (label), its name (title) and a line under it. link: an
/// Open Displays button beside it.
export struct SystemFact { icon: string, label: string, title: string, detail: string, link: bool }
/// A file system on a drive: where it's mounted, its kind, how full (0–1), and that in words.
export struct SystemFs { mounts: string, kind: string, used: float, text: string, warn: bool }
export struct SystemDrive { name: string, meta: string, filesystems: [SystemFs] }
/// A row of names and values: "Kernel  7.2.14-arch1-1", mono for versions.
export struct SystemSoftware { name: string, version: string, note: string, mono: bool }
/// A package manager's updates. state: "checking", "count", "none", "error" or "running"; text:
/// "23 updates", "Up to date", why it couldn't check, "Updating in kitty…".
export struct SystemUpdate { key: string, name: string, source: string, state: string, text: string }
/// state: "list" or "loading". name: the pretty name if there is one (`pretty`), else the
/// hostname. report: the page as plain text, for the bug button.
export struct SystemView {
    state: string,
    sub: string,
    name: string,
    hostname: string,
    pretty: bool,
    line: string,
    logo: image,
    monogram: string,
    facts: [SystemFact],
    unknown: string,
    drives: [SystemDrive],
    drive-count: string,
    distro-name: string,
    distro-detail: string,
    distro: [SystemSoftware],
    updates-title: string,
    checked: string,
    checking: bool,
    update-all: bool,
    updates: [SystemUpdate],
    updates-note: string,
    software: [SystemSoftware],
    uses: [SystemSoftware],
    report: string,
    copied: bool,
}

component Fact inherits Rectangle {
    in property <SystemFact> fact;
    callback opened();
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;
        IconTile { icon: root.fact.icon; y: 2px; }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.fact.label; color: Theme.faint; font-size: Type.note; }
            Text { text: root.fact.title; color: Theme.text; font-size: Type.body; font-weight: 500; overflow: elide; }
            Text { text: root.fact.detail; color: Theme.muted; font-size: Type.note; overflow: elide; }
        }
        if root.fact.link: VerticalLayout {
            alignment: center;
            Button { label: "Open Displays"; button-height: Size.button-row; horizontal-stretch: 0; clicked => { root.opened(); } }
        }
    }
}

/// A name, its value and a note on the right; a line above it unless it's the first.
// Not DividerRow, whose rows are 48 px at least: these facts are a compact list, so the card
// fits at 1070 px. The same divider.
component SoftwareRow inherits Rectangle {
    in property <SystemSoftware> entry;
    in property <bool> first;
    in property <bool> narrow;
    height: 40px;
    Rectangle { y: 0; height: 1px; background: root.first ? transparent : Theme.border; }
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.entry.name; color: Theme.muted; font-size: Type.body; vertical-alignment: center; width: root.narrow ? 110px : 150px; overflow: elide; }
        Text {
            text: root.entry.version;
            color: root.entry.version == "Not installed" || root.entry.version == "Not running" ? Theme.faint : Theme.text;
            font-size: Type.body;
            font-family: root.entry.mono ? "JetBrains Mono" : "Inter";
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text { text: root.entry.note; color: Theme.faint; font-size: Type.note; vertical-alignment: center; }
    }
}

component UpdateRow inherits Rectangle {
    in property <SystemUpdate> entry;
    in property <bool> first;
    in property <bool> narrow;
    callback update();
    height: 46px;
    Rectangle { y: 0; height: 1px; background: root.first ? transparent : Theme.border; }
    HorizontalLayout {
        spacing: 12px;
        HorizontalLayout {
            width: root.narrow ? 110px : 150px;
            spacing: 8px;
            Icon { name: "package"; tint: Theme.muted; size: 15px; y: (parent.height - 15px) / 2; }
            Text { text: root.entry.name; color: Theme.text; font-size: Type.body; vertical-alignment: center; overflow: elide; }
        }
        Text { text: root.entry.source; color: Theme.faint; font-size: Type.note; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.entry.state == "none": Icon { name: "check"; tint: Theme.muted; size: 13px; y: (parent.height - 13px) / 2; }
        Text {
            text: root.entry.text;
            color: root.entry.state == "count" ? Theme.accent : root.entry.state == "error" ? Theme.warn-text : Theme.muted;
            font-size: Type.body;
            font-weight: root.entry.state == "count" ? 600 : 400;
            vertical-alignment: center;
            max-width: root.narrow ? 160px : 260px;
            overflow: elide;
        }
        if root.entry.state == "count": VerticalLayout {
            alignment: center;
            Button { label: "Update"; button-height: Size.button-row; horizontal-stretch: 0; clicked => { root.update(); } }
        }
    }
}

export component SystemPage inherits VerticalLayout {
    in property <SystemView> view;
    in property <bool> compact;
    /// A small window: a narrower right column.
    in property <bool> narrow;
    callback rename();
    callback copied();
    callback open-displays();
    /// "check", "update" (a package manager's key), "update-all".
    callback act(string, string);
    spacing: 14px;

    Hero {
        title: "System";
        sub: root.view.sub;
        hero-height: root.compact ? 136px : 206px;
        compact: root.compact;
        aside: bug.width + 18px;
        // The computer: its logo (or first letter), its name with the rename button (F2 too), its
        // network name, and what it is.
        HeroSubject {
            compact: root.compact;
            loading: root.view.state != "list";
            info: { name: root.view.name };
            logo: root.view.logo;
            monogram: root.view.monogram;
            editable: true;
            edit-label: "Rename this computer";
            edit => { root.rename(); }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text { text: root.view.hostname; color: Theme.text; font-size: Type.body; font-family: "JetBrains Mono"; }
                Text { text: "on the network"; color: Theme.muted; font-size: Type.body; }
            }
            if !root.compact: Text { text: root.view.line; color: Theme.muted; font-size: Type.body; overflow: elide; }
        }
        // The page as plain text for a bug report; a check for two seconds after.
        bug := IconButton {
            x: parent.width - self.width - 18px;
            y: 18px;
            size: root.view.state == "list" ? 34px : 0;
            icon: root.view.copied ? "check" : "bug";
            label: "Copy system info for a bug report";
            clicked => { copy-field.select-all(); copy-field.copy(); root.copied(); }
        }
        copy-field := TextInput { visible: false; width: 0; height: 0; text: root.view.report; read-only: true; }
        if bug.has-hover || root.view.copied: Tooltip {
            x: parent.width - self.width - 18px;
            y: bug.y + bug.height + 8px;
            width: 290px;
            text: root.view.copied ? "Copied · paste it into an issue or a forum post"
                : "Copy system info for a bug report\nThis page as plain text, without the computer's names and serial numbers";
        }
    }
    if root.view.state == "list": HorizontalLayout {
        spacing: 14px;
        vertical-stretch: 1;
        // The hardware and the drives; the drives reach the bottom.
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 18px;
                    padding-top: 14px;
                    spacing: 8px;
                    CardTitle { text: "Hardware"; }
                    facts := Rectangle {
                        property <int> columns: self.width >= 460px ? 2 : 1;
                        height: ceil(root.view.facts.length / self.columns) * 76px;
                        for f[i] in root.view.facts: Fact {
                            x: mod(i, facts.columns) * facts.width / facts.columns;
                            y: floor(i / facts.columns) * 76px;
                            width: facts.width / facts.columns;
                            height: 76px;
                            fact: f;
                            opened => { root.open-displays(); }
                        }
                    }
                    if root.view.unknown != "": Text { text: root.view.unknown; color: Theme.faint; font-size: Type.note; wrap: word-wrap; }
                }
            }
            ScrollCard {
                VerticalLayout {
                    padding: 18px;
                    padding-top: 14px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 30px;
                        CardTitle { text: "Storage"; horizontal-stretch: 1; }
                        Text { text: root.view.drive-count; color: Theme.faint; font-size: Type.note; vertical-alignment: center; }
                    }
                    for d in root.view.drives: VerticalLayout {
                        spacing: 6px;
                        padding-bottom: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            height: 28px;
                            Icon { name: "drive"; tint: Theme.muted; size: 16px; y: (parent.height - 16px) / 2; }
                            Text { text: d.name; color: Theme.text; font-size: Type.body; font-weight: 500; vertical-alignment: center; overflow: elide; }
                            Text { text: d.meta; color: Theme.faint; font-size: Type.note; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        for f in d.filesystems: HorizontalLayout {
                            padding-left: 26px;
                            spacing: 16px;
                            height: 40px;
                            VerticalLayout {
                                width: root.narrow ? 110px : 180px;
                                alignment: center;
                                Text { text: f.mounts; color: Theme.text; font-size: Type.body; font-family: "JetBrains Mono"; overflow: elide; }
                                Text { text: f.kind; color: Theme.faint; font-size: Type.note; }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 6px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                background: Theme.ctrl-border;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * clamp(f.used, 0, 1);
                                    border-radius: 3px;
                                    background: f.warn ? Theme.warn-text : Theme.accent;
                                }
                            }
                            Text { text: f.text; color: Theme.muted; font-size: Type.note; vertical-alignment: center; horizontal-alignment: right; width: root.narrow ? 150px : 200px; overflow: elide; }
                        }
                    }
                }
            }
        }
        // Software, the whole height: the distribution, updates, what runs, what the pages use.
        ScrollCard {
            width: root.narrow ? 380px : 560px;
            VerticalLayout {
                padding: 18px;
                padding-top: 14px;
                spacing: 0;
                CardTitle { text: "Software"; }
                SectionLabel { text: "DISTRIBUTION"; height: 26px; vertical-alignment: center; }
                HorizontalLayout {
                    height: 40px;
                    spacing: 12px;
                    Text { text: "Name"; color: Theme.muted; font-size: Type.body; vertical-alignment: center; width: root.narrow ? 110px : 150px; }
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        Image { width: 16px; height: 16px; y: 12px; source: root.view.logo; image-fit: contain; }
                        Text { text: root.view.distro-name; color: Theme.text; font-size: Type.body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                    Text { text: root.view.distro-detail; color: Theme.faint; font-size: Type.note; vertical-alignment: center; }
                }
                for r in root.view.distro: SoftwareRow { entry: r; narrow: root.narrow; }
                HorizontalLayout {
                    height: 44px;
                    padding-top: 10px;
                    spacing: 8px;
                    SectionLabel { text: root.view.updates-title; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: root.view.checked; color: Theme.faint; font-size: Type.note; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        IconButton { icon: "rescan"; label: "Check again"; size: 26px; icon-size: 14px; flat: true; enabled: !root.view.checking; clicked => { root.act("check", ""); } }
                    }
                    if root.view.update-all: VerticalLayout {
                        alignment: center;
                        Button { label: "Update all"; kind: "primary"; button-height: Size.button-row; horizontal-stretch: 0; clicked => { root.act("update-all", ""); } }
                    }
                }
                for u[i] in root.view.updates: UpdateRow {
                    entry: u;
                    first: i == 0;
                    narrow: root.narrow;
                    update => { root.act("update", u.key); }
                }
                if root.view.updates-note != "": Text {
                    text: root.view.updates-note;
                    color: Theme.faint;
                    font-size: Type.note;
                    wrap: word-wrap;
                    min-height: 26px;
                    vertical-alignment: bottom;
                }
                SectionLabel { text: "THIS COMPUTER RUNS"; height: 44px; vertical-alignment: bottom; }
                for r[i] in root.view.software: SoftwareRow { entry: r; first: i == 0; narrow: root.narrow; }
                SectionLabel { text: "WHAT LITUUS'S PAGES USE"; height: 44px; vertical-alignment: bottom; }
                for r[i] in root.view.uses: SoftwareRow { entry: r; first: i == 0; narrow: root.narrow; }
            }
        }
    }
    if root.view.state != "list": HorizontalLayout {
        spacing: 14px;
        vertical-stretch: 1;
        Card { horizontal-stretch: 1; EmptyState { loading: true; title: "Reading this computer…"; } }
        Card { width: root.narrow ? 380px : 560px; EmptyState { loading: true; title: " "; } }
    }
}
