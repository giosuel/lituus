// The colours, set from Rust (src/theme.rs): the built-in theme, or the first usable colour
// source in config.toml. The defaults are the built-in dark theme.

export global Theme {
    in-out property <color> bg: #141619;
    in-out property <color> panel: #111315;
    in-out property <color> surface: #1b1e21;
    in-out property <color> border: #23272b;
    in-out property <color> border2: #2f343a;
    /// A control's edge, 3:1 against what it sits on.
    in-out property <color> ctrl-border: #696f76;
    in-out property <color> ctrl-bg: #23272b;
    in-out property <color> input-bg: #1f2226;
    in-out property <color> text: #e8eaed;
    in-out property <color> muted: #a0a7af;
    in-out property <color> faint: #8b929a;
    in-out property <color> icon-soft: #a0a7af;
    in-out property <color> accent: #5cc8b0;
    in-out property <color> on-accent: #0c1513;
    in-out property <color> accent-soft-bg: #1f2a27;
    in-out property <color> accent-soft-border: #2c4a42;
    in-out property <color> off-track: #353a40;
    in-out property <color> knob-off: #8b929a;
    in-out property <color> bar-off: #353a40;
    /// The old hover colour; use `hover` instead.
    in-out property <color> sel-bg: #23272b;
    in-out property <color> danger: #f08a7a;
    in-out property <color> warn-bg: #2a2518;
    in-out property <color> warn-border: #5a4c25;
    in-out property <color> warn-text: #e9cf8f;
    /// Over pictures and behind dialogs; the same in every theme.
    out property <color> scrim: #05060799;
    /// Text and marks on `overlay` (a label over a picture).
    out property <color> on-scrim: #ffffff;
    out property <color> overlay: #000000b0;
    out property <color> shadow-soft: #00000040;
    out property <color> shadow: #00000066;
    out property <color> shadow-strong: #00000080;
    /// The accent glow behind a page's hero, and whether to draw it.
    in-out property <color> glow: #233230;
    in-out property <bool> gradient: true;

    /// Hover, on a transparent background: a light tint of the text colour, so it fits on any
    /// background (the hero's glow too) and stays weaker than the selected state.
    out property <color> hover: text.transparentize(0.94);

    /// Hover on a filled control: its background with the same tint.
    public pure function hovered(background: color) -> color {
        return background.mix(text, 0.94);
    }

    // A tone name from Rust ("accent", "danger", "muted", "faint") as a colour.
    public pure function tone(name: string) -> color {
        if name == "accent" { return accent; }
        if name == "danger" { return danger; }
        if name == "faint" { return faint; }
        if name == "warn" { return warn-text; }
        if name == "text" { return text; }
        return muted;
    }
}

/// The type scale (the One UI library, D-46): one size per role. ui_tokens.rs fails on a raw
/// font size anywhere else.
export global Type {
    /// A page's title in its hero.
    out property <length> page-title: 30px;
    /// The hero's subject: the network, the device, the computer.
    out property <length> subject: 22px;
    /// Big keys and digits (a PIN, a shortcut being recorded).
    out property <length> display: 26px;
    out property <length> dialog-title: 17px;
    out property <length> card-title: 15px;
    /// A row's name, text, fields and buttons.
    out property <length> body: 13px;
    /// Hints, footers, a row's second line (faint).
    out property <length> note: 12px;
    /// Section labels (caps) and badges.
    out property <length> label: 11px;
}

/// One size per role (D-46).
export global Size {
    out property <length> button: 34px;
    /// Inside rows and notices.
    out property <length> button-row: 28px;
    /// Dialog footers.
    out property <length> button-dialog: 36px;
    out property <length> field: 34px;
    out property <length> field-dialog: 38px;
    out property <length> icon-button-row: 24px;
    out property <length> icon-button: 32px;
    out property <length> icon-button-hero: 34px;
}
